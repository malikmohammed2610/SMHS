<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

   

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/logo.png">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Main Website CSS -->
    <link rel="stylesheet" href="/css/style.css">

    <style>

        /* ============================================================
           CURRICULUM PAGE — PREMIUM DESIGN
        ============================================================ */

        :root {
            --curr-navy: #071426;
            --curr-navy-2: #0d1d32;
            --curr-navy-3: #142842;
            --curr-ivory: #f7f4ed;
            --curr-white: #ffffff;
            --curr-gold: #c6a45c;
            --curr-gold-light: #dfc98f;
            --curr-text: #273244;
            --curr-muted: #6e7887;
            --curr-border: rgba(20, 40, 66, 0.10);
            --curr-shadow: 0 18px 50px rgba(7, 20, 38, 0.10);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: var(--curr-ivory);
            color: var(--curr-text);
            font-family: 'Inter', sans-serif;
            line-height: 1.7;
        }

        a {
            text-decoration: none;
        }

        /* ============================================================
           TOP BAR
        ============================================================ */

        .academic-topbar {
            background: var(--curr-navy);
            color: rgba(255,255,255,0.82);
            padding: 900px 0;
            font-size: 12px;
            letter-spacing: 0.3px;
        }

        .academic-topbar-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 200px;
        }

        .topbar-left,
        .topbar-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .topbar-item {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .topbar-item i {
            color: var(--curr-gold-light);
        }

        /* ============================================================
           MAIN HEADER
        ============================================================ */

        .main-header {
            position: relative;
            z-index: 1000;
            background: rgba(255,255,255,0.98);
            border-bottom: 1px solid rgba(198,164,92,0.28);
            box-shadow: 0 8px 30px rgba(7,20,38,0.05);
        }

        .header-inner {
            min-height: 94px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
        }

        .school-brand {
            display: flex;
            align-items: center;
            gap: 15px;
            color: var(--curr-navy);
        }

        .school-brand:hover {
            color: var(--curr-navy);
        }

        .school-logo {
            width: 64px;
            height: 64px;
            object-fit: contain;
        }

        .brand-text {
            line-height: 1.05;
        }

        .brand-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 27px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .brand-subtitle {
            margin-top: 5px;
            color: #777;
            font-size: 10px;
            letter-spacing: 2.4px;
            text-transform: uppercase;
        }

        /* ============================================================
           NAVIGATION
        ============================================================ */

        .main-navigation {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .main-navigation a {
            position: relative;
            color: #273244;
            padding: 12px 13px;
            font-size: 13px;
            font-weight: 600;
            transition: 0.25s ease;
        }

        .main-navigation a::after {
            content: "";
            position: absolute;
            left: 13px;
            right: 13px;
            bottom: 4px;
            height: 1px;
            background: var(--curr-gold);
            transform: scaleX(0);
            transform-origin: center;
            transition: transform 0.25s ease;
        }

        .main-navigation a:hover,
        .main-navigation a.active {
            color: #9c7b36;
        } 

        .main-navigation a:hover::after,
        .main-navigation a.active::after {
            transform: scaleX(1);
        }

        .header-admission-btn {
            background: var(--curr-navy);
            color: white !important;
            padding: 12px 19px !important;
            margin-left: 10px;
            border: 1px solid var(--curr-navy);
            transition: 0.25s ease;
        }

        .header-admission-btn:hover {
            background: var(--curr-gold);
            border-color: var(--curr-gold);
        }

        .header-admission-btn::after {
            display: none;
        }

        /* ============================================================
           HERO
        ============================================================ */

        .curriculum-hero {
            position: relative;
            overflow: hidden;
            min-height: 590px;
            background:
                linear-gradient(
                    90deg,
                    rgba(7,20,38,0.97) 0%,
                    rgba(7,20,38,0.91) 43%,
                    rgba(7,20,38,0.60) 72%,
                    rgba(7,20,38,0.78) 100%
                ),
                url('/images/curriculum.jpg') center/cover no-repeat;
            display: flex;
            align-items: center;
        }

        .curriculum-hero::before {
            content: "";
            position: absolute;
            width: 420px;
            height: 420px;
            border: 1px solid rgba(198,164,92,0.28);
            border-radius: 50%;
            right: -150px;
            top: -100px;
        }

        .curriculum-hero::after {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            border: 1px solid rgba(198,164,92,0.18);
            border-radius: 50%;
            right: 45px;
            bottom: -130px;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 850px;
            color: white;
            padding: 80px 0;
        }

        .hero-kicker {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            color: var(--curr-gold-light);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .hero-kicker::before {
            content: "";
            width: 42px;
            height: 1px;
            background: var(--curr-gold);
        }

        .hero-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(54px, 7vw, 88px);
            line-height: 0.96;
            font-weight: 600;
            margin: 0 0 25px;
        }

        .hero-title span {
            color: var(--curr-gold-light);
        }

        .hero-description {
            max-width: 720px;
            color: rgba(255,255,255,0.82);
            font-size: 16px;
            line-height: 1.9;
            font-weight: 300;
            margin-bottom: 35px;
        }

        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .hero-btn {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 14px 22px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            transition: 0.25s ease;
        }

        .hero-btn-primary {
            background: var(--curr-gold);
            color: var(--curr-navy);
        }

        .hero-btn-primary:hover {
            background: #d7b96f;
            color: var(--curr-navy);
            transform: translateY(-2px);
        }

        .hero-btn-outline {
            color: white;
            border: 1px solid rgba(255,255,255,0.35);
        }

        .hero-btn-outline:hover {
            color: white;
            background: rgba(255,255,255,0.10);
            border-color: rgba(255,255,255,0.65);
        }

        /* ============================================================
           INTRO
        ============================================================ */

        .section {
            padding: 100px 0;
        }

        .section-small {
            padding: 75px 0;
        }

        .section-label {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: #a18443;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

        .section-label::before {
            content: "";
            width: 32px;
            height: 1px;
            background: var(--curr-gold);
        }

        .section-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(40px, 5vw, 62px);
            line-height: 1.05;
            font-weight: 600;
            color: var(--curr-navy);
            margin-bottom: 20px;
        }

        .section-title span {
            color: #a3833e;
        }

        .section-description {
            color: var(--curr-muted);
            font-size: 15px;
            line-height: 1.9;
            max-width: 750px;
        }

        .intro-panel {
            background: white;
            box-shadow: var(--curr-shadow);
            padding: 55px;
            border-top: 3px solid var(--curr-gold);
        }

        .intro-panel p {
            color: #596474;
            font-size: 15px;
            line-height: 1.95;
            margin-bottom: 18px;
        }

        .intro-panel p:last-child {
            margin-bottom: 0;
        }

        /* ============================================================
           PRINCIPLES
        ============================================================ */

        .principles-section {
            background: white;
        }

        .principle-card {
            height: 100%;
            padding: 34px 30px;
            border: 1px solid var(--curr-border);
            background: #fff;
            transition: 0.3s ease;
        }

        .principle-card:hover {
            transform: translateY(-7px);
            box-shadow: var(--curr-shadow);
            border-color: rgba(198,164,92,0.4);
        }

        .principle-number {
            font-family: 'Cormorant Garamond', serif;
            color: var(--curr-gold);
            font-size: 46px;
            line-height: 1;
            margin-bottom: 18px;
        }

        .principle-icon {
            width: 52px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--curr-navy);
            color: var(--curr-gold-light);
            font-size: 18px;
            margin-bottom: 22px;
        }

        .principle-card h3 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 27px;
            color: var(--curr-navy);
            margin-bottom: 12px;
        }

        .principle-card p {
            color: var(--curr-muted);
            font-size: 13px;
            line-height: 1.8;
            margin: 0;
        }

        /* ============================================================
           ACADEMIC STAGES
        ============================================================ */

        .stages-section {
            background: var(--curr-ivory);
        }

        .stage-card {
            position: relative;
            height: 100%;
            background: white;
            padding: 38px;
            border: 1px solid var(--curr-border);
            overflow: hidden;
            transition: 0.3s ease;
        }

        .stage-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--curr-shadow);
        }

        .stage-card::after {
            content: "";
            position: absolute;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 1px solid rgba(198,164,92,0.18);
            right: -45px;
            top: -45px;
        }

        .stage-index {
            color: var(--curr-gold);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .stage-card h3 {
            font-family: 'Cormorant Garamond', serif;
            color: var(--curr-navy);
            font-size: 34px;
            margin: 10px 0 7px;
        }

        .stage-subtitle {
            color: #9c7b36;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 20px;
        }

        .stage-card p {
            color: var(--curr-muted);
            font-size: 13px;
            line-height: 1.8;
        }

        .stage-list {
            list-style: none;
            padding: 0;
            margin: 22px 0 0;
        }

        .stage-list li {
            position: relative;
            padding-left: 22px;
            color: #4f5968;
            font-size: 13px;
            margin-bottom: 9px;
        }

        .stage-list li::before {
            content: "\f00c";
            font-family: "Font Awesome 6 Free";
            font-weight: 900;
            position: absolute;
            left: 0;
            top: 1px;
            color: var(--curr-gold);
            font-size: 11px;
        }

        /* ============================================================
           SUBJECTS
        ============================================================ */

        .subjects-section {
            background: white;
        }

        .subject-box {
            height: 100%;
            padding: 32px;
            background: #fbfaf7;
            border: 1px solid rgba(20,40,66,0.08);
            transition: 0.3s ease;
        }

        .subject-box:hover {
            background: var(--curr-navy);
            transform: translateY(-5px);
        }

        .subject-box:hover h3,
        .subject-box:hover p,
        .subject-box:hover li {
            color: white;
        }

        .subject-icon {
            width: 55px;
            height: 55px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(198,164,92,0.14);
            color: #a3833e;
            font-size: 19px;
            margin-bottom: 22px;
        }

        .subject-box:hover .subject-icon {
            background: rgba(198,164,92,0.16);
            color: var(--curr-gold-light);
        }

        .subject-box h3 {
            font-family: 'Cormorant Garamond', serif;
            color: var(--curr-navy);
            font-size: 29px;
            margin-bottom: 12px;
            transition: 0.3s ease;
        }

        .subject-box p {
            color: var(--curr-muted);
            font-size: 13px;
            line-height: 1.8;
            margin-bottom: 16px;
            transition: 0.3s ease;
        }

        .subject-box ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .subject-box li {
            color: #5b6573;
            font-size: 12px;
            margin-bottom: 7px;
            transition: 0.3s ease;
        }

        .subject-box li i {
            color: var(--curr-gold);
            width: 17px;
        }

        /* ============================================================
           LEARNING MODEL
        ============================================================ */

        .learning-section {
            background: var(--curr-navy);
            color: white;
            position: relative;
            overflow: hidden;
        }

        .learning-section::before {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            border: 1px solid rgba(198,164,92,0.12);
            border-radius: 50%;
            left: -260px;
            top: -180px;
        }

        .learning-section .section-title {
            color: white;
        }

        .learning-section .section-description {
            color: rgba(255,255,255,0.68);
        }

        .learning-item {
            display: flex;
            gap: 22px;
            padding: 25px 0;
            border-bottom: 1px solid rgba(255,255,255,0.10);
        }

        .learning-item:last-child {
            border-bottom: 0;
        }

        .learning-icon {
            flex: 0 0 52px;
            width: 52px;
            height: 52px;
            border: 1px solid rgba(198,164,92,0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--curr-gold-light);
        }

        .learning-item h3 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 27px;
            margin: 0 0 6px;
        }

        .learning-item p {
            margin: 0;
            color: rgba(255,255,255,0.62);
            font-size: 13px;
            line-height: 1.75;
        }

        .learning-statement {
            position: relative;
            z-index: 2;
            padding: 48px;
            border: 1px solid rgba(198,164,92,0.25);
            background: rgba(255,255,255,0.035);
        }

        .learning-statement i {
            color: var(--curr-gold);
            font-size: 28px;
            margin-bottom: 20px;
        }

        .learning-statement h3 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 37px;
            line-height: 1.2;
            margin-bottom: 16px;
        }

        .learning-statement p {
            color: rgba(255,255,255,0.65);
            font-size: 14px;
            line-height: 1.85;
        }

        /* ============================================================
           ASSESSMENT
        ============================================================ */

        .assessment-section {
            background: var(--curr-ivory);
        }

        .assessment-card {
            background: white;
            padding: 35px;
            height: 100%;
            border: 1px solid var(--curr-border);
        }

        .assessment-card h3 {
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: 'Cormorant Garamond', serif;
            font-size: 28px;
            color: var(--curr-navy);
            margin-bottom: 14px;
        }

        .assessment-card h3 i {
            color: var(--curr-gold);
            font-size: 18px;
        }

        .assessment-card p {
            color: var(--curr-muted);
            font-size: 13px;
            line-height: 1.8;
            margin: 0;
        }

        /* ============================================================
           CO-CURRICULAR
        ============================================================ */

        .co-curricular-section {
            background: white;
        }

        .development-panel {
            background: var(--curr-navy);
            color: white;
            padding: 55px;
            height: 100%;
        }

        .development-panel .section-label {
            color: var(--curr-gold-light);
        }

        .development-panel h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 46px;
            line-height: 1.1;
            margin-bottom: 18px;
        }

        .development-panel p {
            color: rgba(255,255,255,0.67);
            font-size: 14px;
            line-height: 1.85;
        }

        .development-list {
            margin: 30px 0 0;
            padding: 0;
            list-style: none;
        }

        .development-list li {
            display: flex;
            gap: 13px;
            align-items: flex-start;
            color: rgba(255,255,255,0.82);
            font-size: 13px;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255,255,255,0.09);
        }

        .development-list i {
            color: var(--curr-gold-light);
            margin-top: 5px;
        }

        .development-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            height: 100%;
        }

        .development-tile {
            min-height: 160px;
            padding: 28px;
            background: #fbfaf7;
            border: 1px solid var(--curr-border);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            transition: 0.25s ease;
        }

        .development-tile:hover {
            background: #f3eee3;
            transform: translateY(-4px);
        }

        .development-tile i {
            color: #a3833e;
            font-size: 20px;
            margin-bottom: auto;
        }

        .development-tile h4 {
            font-family: 'Cormorant Garamond', serif;
            color: var(--curr-navy);
            font-size: 25px;
            margin: 25px 0 0;
        }

        /* ============================================================
           ACADEMIC JOURNEY
        ============================================================ */

        .journey-section {
            background: var(--curr-ivory);
        }

        .journey {
            position: relative;
            max-width: 900px;
            margin: 45px auto 0;
        }

        .journey::before {
            content: "";
            position: absolute;
            left: 28px;
            top: 0;
            bottom: 0;
            width: 1px;
            background: rgba(198,164,92,0.45);
        }

        .journey-item {
            position: relative;
            display: flex;
            gap: 30px;
            margin-bottom: 35px;
        }

        .journey-number {
            position: relative;
            z-index: 2;
            flex: 0 0 57px;
            width: 57px;
            height: 57px;
            border-radius: 50%;
            background: var(--curr-navy);
            border: 4px solid var(--curr-ivory);
            box-shadow: 0 0 0 1px rgba(198,164,92,0.5);
            color: var(--curr-gold-light);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Cormorant Garamond', serif;
            font-size: 23px;
        }

        .journey-content {
            background: white;
            padding: 25px 30px;
            flex: 1;
            border: 1px solid var(--curr-border);
        }

        .journey-content h3 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 29px;
            color: var(--curr-navy);
            margin-bottom: 7px;
        }

        .journey-content p {
            color: var(--curr-muted);
            font-size: 13px;
            line-height: 1.8;
            margin: 0;
        }

        /* ============================================================
           CTA
        ============================================================ */

        .curriculum-cta {
            background:
                linear-gradient(
                    135deg,
                    rgba(7,20,38,0.98),
                    rgba(18,39,65,0.98)
                );
            padding: 85px 0;
            position: relative;
            overflow: hidden;
        }

        .curriculum-cta::after {
            content: "";
            position: absolute;
            width: 420px;
            height: 420px;
            border: 1px solid rgba(198,164,92,0.14);
            border-radius: 50%;
            right: -190px;
            top: -150px;
        }

        .cta-inner {
            position: relative;
            z-index: 2;
            text-align: center;
            max-width: 820px;
            margin: auto;
        }

        .cta-inner .section-label {
            color: var(--curr-gold-light);
        }

        .cta-title {
            font-family: 'Cormorant Garamond', serif;
            color: white;
            font-size: clamp(40px, 5vw, 61px);
            line-height: 1.05;
            margin-bottom: 18px;
        }

        .cta-text {
            color: rgba(255,255,255,0.66);
            font-size: 14px;
            max-width: 680px;
            margin: 0 auto 28px;
        }

        /* ============================================================
           FOOTER
        ============================================================ */

        .site-footer {
            background: #050e1a;
            color: rgba(255,255,255,0.70);
        }

        .footer-main {
            padding: 75px 0 55px;
        }

        .footer-brand {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 22px;
        }

        .footer-logo {
            width: 62px;
            height: 62px;
            object-fit: contain;
        }

        .footer-school-name {
            font-family: 'Cormorant Garamond', serif;
            color: white;
            font-size: 28px;
            line-height: 1;
        }

        .footer-school-subtitle {
            color: var(--curr-gold-light);
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 9px;
            margin-top: 6px;
        }

        .footer-description {
