            color: rgba(255,255,255,0.55);
            font-size: 13px;
            line-height: 1.9;
        }

        .footer-heading {
            color: white;
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 20px;
            font-weight: 700;
        }

        .footer-links {
