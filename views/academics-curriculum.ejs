            width: 34px;
            height: 34px;
            border: 1px solid rgba(255,255,255,0.13);
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(255,255,255,0.60);
            font-size: 13px;
            transition: 0.25s ease;
        }

        .footer-social a:hover {
            color: var(--curr-gold-light);
            border-color: var(--curr-gold);
        }

        /* ============================================================
           BACK TO TOP
        ============================================================ */

        .back-to-top {
            position: fixed;
            right: 24px;
            bottom: 24px;
            width: 43px;
            height: 43px;
            background: var(--curr-gold);
            color: var(--curr-navy);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 999;
            opacity: 0;
            visibility: hidden;
            transform: translateY(15px);
            transition: 0.3s ease;
            cursor: pointer;
        }

        .back-to-top.show {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .back-to-top:hover {
            background: var(--curr-navy);
            color: white;
        }

