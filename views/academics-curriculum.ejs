            gap: 11px;
            margin-bottom: 13px;
            font-size: 13px;
            color: rgba(255,255,255,0.55);
        }

        .footer-contact i {
            color: var(--curr-gold-light);
            width: 16px;
            margin-top: 5px;
        }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.09);
            padding: 20px 0;
        }

        .footer-bottom-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .footer-copyright {
            font-size: 11px;
            color: rgba(255,255,255,0.42);
        }

        .footer-social {
            display: flex;
            gap: 8px;
        }

