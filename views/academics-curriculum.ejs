            padding: 0;
            margin: 0;
        }

        .footer-links li {
            margin-bottom: 10px;
        }

        .footer-links a {
            color: rgba(255,255,255,0.55);
            font-size: 13px;
            transition: 0.2s ease;
        }

        .footer-links a:hover {
            color: var(--curr-gold-light);
            padding-left: 4px;
        }

        .footer-contact {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .footer-contact li {
