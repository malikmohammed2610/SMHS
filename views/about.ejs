                    </div>

                    <div class="school-location">
                        BALANAGAR, HYDERABAD
                    </div>

                </div>

            </a>


            <!-- DESKTOP NAV -->

            <nav class="school-nav">

                <a href="/">HOME</a>

                <div class="nav-dropdown">

                    <a href="/about" class="active">
                        ABOUT
                        <i class="fa-solid fa-chevron-down"></i>
                    </a>

                    <div class="nav-dropdown-menu">

                        <a href="/about">
                            School Overview
                        </a>

                        <a href="/principal-management">
                            Principal & Management
                        </a>

                        <a href="/educational-society">
                            Educational Society
                        </a>

                        <a href="/disclosure">
                            Disclosure
                        </a>

                    </div>

                </div>


                <a href="/facilities">
                    FACILITIES
                </a>


                <a href="/admissions">
                    ADMISSIONS
                </a>


                <a href="/curriculum">
                    CURRICULUM
                </a>


                <a href="/student-life">
