<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>About | St. Martin's High School, Balanagar</title>

    <!-- FAVICON -->
    <link rel="icon" type="image/png" href="/images/logo.png">

    <!-- GOOGLE FONTS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- BOOTSTRAP -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- FONT AWESOME -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- GLOBAL CSS -->
    <link rel="stylesheet" href="/css/style.css">


    <style>

        /* =========================================================
           PAGE VARIABLES
        ========================================================= */

        :root {

            --navy: #071A2B;
            --navy-dark: #04111D;
            --navy-soft: #0D263D;

            --gold: #C5A45A;
            --gold-light: #E0CA8B;

            --ivory: #F6F1E7;
            --cream: #FBF8F1;

            --white: #FFFFFF;
            --charcoal: #20252A;
            --muted: #6C737A;

        }


        /* =========================================================
           GLOBAL
        ========================================================= */

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {

            margin: 0;

            padding: 0;

            background: var(--ivory);

            color: var(--charcoal);

            font-family: "Inter", sans-serif;

            overflow-x: hidden;

        }


        /* =========================================================
           CINEMATIC 3D HERO
        ========================================================= */

        .cinematic-hero {

            position: relative;

            width: 100%;

            height: min(820px, calc(100vh - 100px));

            min-height: 650px;

            overflow: hidden;

            background: var(--navy-dark);

            perspective: 1400px;

            isolation: isolate;

        }


        /* =========================================================
           HERO SLIDES
        ========================================================= */

        .hero-slide {

            position: absolute;

            inset: 0;

            width: 100%;

            height: 100%;

            opacity: 0;

            visibility: hidden;

            transform:
                scale(1.08)
                translateZ(-100px);

            transition:

                opacity 1.2s ease,

                transform 1.8s cubic-bezier(.22, .61, .36, 1);

            z-index: 1;

        }


        .hero-slide.active {

            opacity: 1;

            visibility: visible;

            transform:
                scale(1)
                translateZ(0);

            z-index: 2;

        }


        /* =========================================================
           HERO MEDIA
        ========================================================= */

        .hero-media {

            position: absolute;

            inset: 0;

            width: 100%;

            height: 100%;

            object-fit: cover;

            transform:
                scale(1.08)
                translateZ(-40px);

            transition:

                transform 8s cubic-bezier(.2,.7,.2,1);

            filter:
                saturate(.85)
                contrast(1.05);

        }


        .hero-slide.active .hero-media {

            transform:
                scale(1.02)
                translateZ(0);

        }


        .hero-video {

            background: #000;

        }


        /* =========================================================
           HERO IMAGE FALLBACK
        ========================================================= */

        .hero-image {

            position: absolute;

            inset: 0;

            width: 100%;

            height: 100%;

            background-size: cover;

            background-position: center;

        }


        /* =========================================================
           DARK CINEMATIC OVERLAY
        ========================================================= */

        .hero-overlay {

            position: absolute;

            inset: 0;

            z-index: 3;

            background:

                linear-gradient(
                    90deg,
                    rgba(4,17,29,.92) 0%,
                    rgba(4,17,29,.68) 32%,
                    rgba(4,17,29,.25) 68%,
                    rgba(4,17,29,.48) 100%
                ),

                linear-gradient(
                    180deg,
                    rgba(4,17,29,.15) 0%,
                    rgba(4,17,29,.10) 55%,
                    rgba(4,17,29,.78) 100%
                );

            pointer-events: none;

        }


        /* =========================================================
           3D DEPTH LAYERS
        ========================================================= */

        .hero-depth-layer {

            position: absolute;

            inset: -10%;

            pointer-events: none;

            z-index: 4;

            opacity: 0;

            transition:
                opacity 1.4s ease,
                transform 1.4s ease;

        }


        .hero-depth-layer.depth-one {

            background:

                radial-gradient(
                    circle at 70% 35%,
                    rgba(197,164,90,.16),
                    transparent 32%
                );

            transform:
                translate3d(0,0,60px)
                scale(1.05);

        }


        .hero-depth-layer.depth-two {

            background:

                linear-gradient(
                    120deg,
                    transparent 30%,
                    rgba(255,255,255,.04),
                    transparent 65%
                );

            transform:
                translate3d(0,0,100px)
                scale(1.08);

        }


        .hero-slide.active .hero-depth-layer {

            opacity: 1;

        }


        /* =========================================================
           HERO CONTENT
        ========================================================= */

        .hero-content {

            position: relative;

            z-index: 8;

            height: 100%;

            max-width: 1380px;

            margin: auto;

            padding:
                100px 7vw 100px;

            display: flex;

            align-items: center;

        }


        .hero-content-left {

            max-width: 780px;

        }


        .hero-eyebrow {

            display: inline-flex;

            align-items: center;

            gap: 12px;

            margin-bottom: 25px;

            color: var(--gold-light);

            font-size: 12px;

            font-weight: 600;

            letter-spacing: 4px;

            text-transform: uppercase;

        }


        .hero-eyebrow::before {

            content: "";

            width: 45px;

            height: 1px;

            background: var(--gold);

        }


        .hero-title {

            margin: 0;

            color: var(--white);

            font-family:
                "Cormorant Garamond",
                serif;

            font-size:
                clamp(58px, 7vw, 105px);

            font-weight: 500;

            line-height: .9;

            letter-spacing: -2px;

        }


        .hero-title span {

            display: block;

            color: var(--gold-light);

            font-style: italic;

        }


        .hero-description {

            max-width: 650px;

            margin-top: 35px;

            color: rgba(255,255,255,.78);

            font-size: 16px;

            line-height: 1.9;

            font-weight: 300;

        }


        .hero-location {

            margin-top: 22px;

            color: rgba(255,255,255,.65);

            font-size: 12px;

            letter-spacing: 2px;

            text-transform: uppercase;

        }


        /* =========================================================
           HERO BUTTONS
        ========================================================= */

        .hero-buttons {

            display: flex;

            gap: 15px;

            margin-top: 35px;

            flex-wrap: wrap;

        }


        .hero-btn {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            min-width: 165px;

            padding: 15px 26px;

            text-decoration: none;

            font-size: 11px;

            font-weight: 600;

            letter-spacing: 2px;

            text-transform: uppercase;

            transition:
                all .35s ease;

        }


        .hero-btn-gold {

            color: var(--navy-dark);

            background: var(--gold);

            border: 1px solid var(--gold);

        }


        .hero-btn-gold:hover {

            color: var(--navy-dark);

            background: var(--gold-light);

            border-color: var(--gold-light);

            transform:
                translateY(-3px);

        }


        .hero-btn-outline {

            color: var(--white);

            background: transparent;

            border: 1px solid rgba(255,255,255,.45);

        }


        .hero-btn-outline:hover {

            color: var(--white);

            border-color: var(--gold);

            background: rgba(197,164,90,.12);

            transform:
                translateY(-3px);

        }


        /* =========================================================
           HERO RIGHT INFORMATION
        ========================================================= */

        .hero-content-right {

            position: absolute;

            right: 7vw;

            bottom: 105px;

            z-index: 10;

            text-align: right;

        }


        .hero-number {

            color: var(--gold-light);

            font-family:
                "Cormorant Garamond",
                serif;

            font-size: 22px;

        }


        .hero-caption {

            margin-top: 5px;

            color: rgba(255,255,255,.58);

            font-size: 10px;

            letter-spacing: 2px;

            text-transform: uppercase;

        }


        /* =========================================================
           HERO CONTROLS
        ========================================================= */

        .hero-controls {

            position: absolute;

            right: 7vw;

            top: 50%;

            z-index: 20;

            transform:
                translateY(-50%);

            display: flex;

            flex-direction: column;

            gap: 12px;

        }


        .hero-arrow {

            width: 52px;

            height: 52px;

            border: 1px solid rgba(255,255,255,.35);

            background: rgba(4,17,29,.35);

            backdrop-filter:
                blur(8px);

            color: var(--white);

            display: flex;

            align-items: center;

            justify-content: center;

            cursor: pointer;

            transition:
                all .3s ease;

        }


        .hero-arrow:hover {

            border-color: var(--gold);

            color: var(--gold-light);

            background:
                rgba(197,164,90,.12);

        }


        /* =========================================================
           PROGRESS BAR
        ========================================================= */

        .hero-progress-wrap {

            position: absolute;

            left: 7vw;

            right: 7vw;

            bottom: 55px;

            z-index: 20;

            height: 1px;

            background:
                rgba(255,255,255,.18);

        }


        #heroProgress {

            width: 25%;

            height: 2px;

            background: var(--gold);

            transition:
                width .5s ease;

        }


        /* =========================================================
           SLIDE COUNTER
        ========================================================= */

        .hero-counter {

            position: absolute;

            left: 7vw;

            bottom: 72px;

            z-index: 20;

            color: rgba(255,255,255,.7);

            font-size: 11px;

            letter-spacing: 2px;

        }


        #heroCurrent {

            color: var(--gold-light);

            font-size: 18px;

            font-family:
                "Cormorant Garamond",
                serif;

        }


        /* =========================================================
           SCROLL INDICATOR
        ========================================================= */

        .hero-scroll {

            position: absolute;

            right: 7vw;

            bottom: 45px;

            z-index: 20;

            display: flex;

            align-items: center;

            gap: 12px;

            color: rgba(255,255,255,.5);

            font-size: 9px;

            letter-spacing: 3px;

            text-transform: uppercase;

        }


        .scroll-line {

            width: 45px;

            height: 1px;

            background:
                rgba(255,255,255,.4);

        }


        /* =========================================================
           ABOUT INTRO
        ========================================================= */

        .about-intro {

            padding:
                120px 7vw;

            background:
                var(--ivory);

        }


        .about-intro-inner {

            max-width: 1200px;

            margin: auto;

        }


        .section-eyebrow {

            color: var(--gold);

            font-size: 11px;

            font-weight: 600;

            letter-spacing: 3px;

            text-transform: uppercase;

            margin-bottom: 18px;

        }


        .section-title {

            margin: 0;

            color: var(--navy);

            font-family:
                "Cormorant Garamond",
                serif;

            font-size:
                clamp(42px, 5vw, 72px);

            font-weight: 500;

            line-height: 1;

        }


        .section-title span {

            color: var(--gold);

            font-style: italic;

        }


        .about-lead {

            max-width: 850px;

            margin-top: 30px;

            color: #4c5359;

            font-size: 18px;

            line-height: 1.9;

            font-weight: 300;

        }


        /* =========================================================
           CONTENT SECTIONS
        ========================================================= */

        .content-section {

            padding:
                100px 7vw;

        }


        .content-section.light {

            background:
                var(--cream);

        }


        .content-section.dark {

            background:
                var(--navy);

            color: var(--white);

        }


        .content-container {

            max-width: 1250px;

            margin: auto;

        }


        .two-column {

            display: grid;

            grid-template-columns:
                1fr 1fr;

            gap: 80px;

            align-items: center;

        }


        .content-heading {

            margin-bottom: 25px;

            color: var(--navy);

            font-family:
                "Cormorant Garamond",
                serif;

            font-size: 48px;

            font-weight: 500;

            line-height: 1.05;

        }


        .dark .content-heading {

            color: var(--white);

        }


        .content-text {

            color: var(--muted);

            font-size: 15px;

            line-height: 1.9;

        }


        .dark .content-text {

            color:
                rgba(255,255,255,.68);

        }


        /* =========================================================
           GOLD LINE
        ========================================================= */

        .gold-line {

            width: 70px;

            height: 1px;

            background:
                var(--gold);

            margin:
                25px 0;

        }


        /* =========================================================
           VALUE CARDS
        ========================================================= */

        .values-grid {

            display: grid;

            grid-template-columns:
                repeat(3,1fr);

            gap: 1px;

            margin-top: 55px;

            background:
                rgba(197,164,90,.25);

            border:
                1px solid rgba(197,164,90,.25);

        }


        .value-card {

            padding: 45px 35px;

            background:
                var(--navy);

            transition:
                background .3s ease,
                transform .3s ease;

        }


        .value-card:hover {

            background:
                var(--navy-soft);

            transform:
                translateY(-5px);

        }


        .value-icon {

            color:
                var(--gold);

            font-size: 28px;

            margin-bottom: 25px;

        }


        .value-title {

            margin-bottom: 15px;

            color:
                var(--white);

            font-family:
                "Cormorant Garamond",
                serif;

            font-size: 30px;

            font-weight: 500;

        }


        .value-text {

            color:
                rgba(255,255,255,.63);

            font-size: 14px;

            line-height: 1.8;

        }


        /* =========================================================
           HIGHLIGHTS
        ========================================================= */

        .highlights {

            display: grid;

            grid-template-columns:
                repeat(4,1fr);

            gap: 20px;

            margin-top: 50px;

        }


        .highlight {

            padding:
                35px 25px;

            border-top:
                1px solid var(--gold);

        }


        .highlight-number {

            color:
                var(--gold);

            font-family:
                "Cormorant Garamond",
                serif;

            font-size: 48px;

            line-height: 1;

        }


        .highlight-title {

            margin-top: 12px;

            color:
                var(--navy);

            font-size: 12px;

            font-weight: 700;

            letter-spacing: 1.5px;

            text-transform: uppercase;

        }


        .highlight-text {

            margin-top: 12px;

            color:
                var(--muted);

            font-size: 13px;

            line-height: 1.7;

        }


        /* =========================================================
           CLOSING SECTION
        ========================================================= */

        .closing-section {

            padding:
                130px 7vw;

            background:
                var(--navy-dark);

            text-align: center;

        }


        .closing-section h2 {

            max-width: 900px;

            margin:
                auto;

            color:
                var(--white);

            font-family:
                "Cormorant Garamond",
                serif;

            font-size:
                clamp(42px,5vw,70px);

            font-weight: 500;

            line-height: 1;

        }


        .closing-section h2 span {

            color:
                var(--gold-light);

            font-style:
                italic;

        }


        .closing-section p {

            max-width: 700px;

            margin:
                30px auto 0;

            color:
                rgba(255,255,255,.65);

            line-height:
                1.9;

            font-size:
                15px;

        }


        /* =========================================================
           MOBILE
        ========================================================= */

        @media (max-width: 991px) {

            .cinematic-hero {

                min-height:
                    700px;

                height:
                    750px;

            }


            .hero-content {

                padding:
                    80px 30px;

            }


            .hero-content-right {

                right:
                    30px;

                bottom:
                    100px;

            }


            .hero-controls {

                right:
                    30px;

            }


            .hero-progress-wrap {

                left:
                    30px;

                right:
                    30px;

            }


            .hero-counter {

                left:
                    30px;

            }


            .hero-scroll {

                display:
                    none;

            }


            .two-column {

                grid-template-columns:
                    1fr;

                gap:
                    50px;

            }


            .values-grid {

                grid-template-columns:
                    1fr;

            }


            .highlights {

                grid-template-columns:
                    repeat(2,1fr);

            }

        }


        @media (max-width: 600px) {

            .cinematic-hero {

                height:
                    720px;

                min-height:
                    720px;

            }


            .hero-content {

                align-items:
                    flex-end;

                padding:
                    70px 24px 120px;

            }


            .hero-title {

                font-size:
                    55px;

            }


            .hero-description {

                font-size:
                    14px;

            }


            .hero-content-right {

                display:
                    none;

            }


            .hero-controls {

                top:
                    auto;

                right:
                    24px;

                bottom:
                    80px;

                transform:
                    none;

                flex-direction:
                    row;

            }


            .hero-arrow {

                width:
                    45px;

                height:
                    45px;

            }


            .hero-buttons {

                flex-direction:
                    column;

                align-items:
                    flex-start;

            }


            .hero-btn {

                width:
                    100%;

            }


            .about-intro,
            .content-section {

                padding:
                    75px 24px;

            }


            .content-heading {

                font-size:
                    42px;

            }


            .highlights {

                grid-template-columns:
                    1fr;

            }


            .closing-section {

                padding:
                    90px 24px;

            }

        }

    </style>

</head>


<body>


<!-- ============================================================
     HEADER
============================================================ -->

