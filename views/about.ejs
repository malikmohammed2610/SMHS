                </a>

            </nav>


            <!-- HEADER RIGHT -->

            <div class="school-header-right">

                <div class="school-phone">

                    <i class="fa-solid fa-phone"></i>

                    <span>
                        040 - 4020 4839
                    </span>

                </div>

                <a
                    href="/teacher-login"
                    class="teacher-login-btn">

                    <i class="fa-solid fa-user-shield"></i>

                    Teacher Login

                </a>

            </div>

        </div>

    </div>

</header>



<!-- ============================================================
     3D CINEMATIC HERO
============================================================ -->

<section
    class="cinematic-hero"
    id="cinematicHero">


    <!-- ========================================================
         SLIDE 1 — VIDEO
    ========================================================= -->

    <div class="hero-slide active">

        <video
            class="hero-media hero-video"
            autoplay
            muted
            loop
            playsinline
            preload="auto">

            <source
                src="/videos/master-video.mp4"
                type="video/mp4">

        </video>


        <div class="hero-overlay"></div>

        <div class="hero-depth-layer depth-one"></div>

        <div class="hero-depth-layer depth-two"></div>


        <div class="hero-content">

            <div class="hero-content-left">

                <div class="hero-eyebrow">
                    Since 1982
                </div>


                <h1 class="hero-title">

                    A Legacy of

                    <span>
                        Excellence
                    </span>

                </h1>


                <p class="hero-description">

                    St. Martin's High School, Balanagar,
                    is committed to shaping confident,
                    compassionate and capable young minds
                    through knowledge, character and purpose.

                </p>


                <div class="hero-location">

                    <i class="fa-solid fa-location-dot"></i>

                    Balanagar · Hyderabad

                </div>


                <div class="hero-buttons">

                    <a
                        href="/about"
                        class="hero-btn hero-btn-gold">

                        Discover Our Story

                    </a>


                    <a
                        href="/contact"
                        class="hero-btn hero-btn-outline">

                        Visit Our Campus

                    </a>

                </div>

            </div>


            <div class="hero-content-right">

                <div class="hero-number">
                    01
                </div>

                <div class="hero-caption">
                    Our Heritage
                </div>

            </div>

        </div>

    </div>



    <!-- ========================================================
         SLIDE 2 — CAMPUS
    ========================================================= -->

    <div class="hero-slide">

        <img
            class="hero-media"
            src="/images/hero-campus.jpg"
            alt="St. Martin's High School Campus">

        <div class="hero-overlay"></div>

        <div class="hero-depth-layer depth-one"></div>

        <div class="hero-depth-layer depth-two"></div>


        <div class="hero-content">

            <div class="hero-content-left">

                <div class="hero-eyebrow">
                    The Campus
                </div>


                <h2 class="hero-title">

                    A Place to

                    <span>
                        Belong
                    </span>

                </h2>


                <p class="hero-description">

                    A thoughtfully designed learning
                    environment where students are
                    encouraged to explore, participate,
                    collaborate and grow.

                </p>


                <div class="hero-buttons">

                    <a
                        href="/facilities"
                        class="hero-btn hero-btn-gold">

                        Explore Facilities

                    </a>

                </div>

            </div>


            <div class="hero-content-right">

                <div class="hero-number">
                    02
                </div>

                <div class="hero-caption">
